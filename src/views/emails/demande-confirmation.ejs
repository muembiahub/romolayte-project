<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Confirmation de votre demande</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    body {
      margin: 0;
      padding: 0;
      background-color: #f4f6f8;
      font-family: Arial, Helvetica, sans-serif;
      color: #212529;
    }
    .container {
      max-width: 600px;
      margin: 30px auto;
      background-color: #ffffff;
      border-radius: 10px;
      overflow: hidden;
      box-shadow: 0 4px 12px rgba(0,0,0,.08);
    }
    .header {
      background-color: #0d6efd;
      color: #ffffff;
      padding: 24px;
      text-align: center;
    }
    .content {
      padding: 28px;
    }
    .success {
      color: #198754;
      font-size: 20px;
      margin-bottom: 16px;
    }
    .section {
      margin-bottom: 18px;
    }
    .label {
      font-weight: bold;
      color: #0d6efd;
    }
    .value {
      margin-top: 4px;
    }
    .badge {
      display: inline-block;
      padding: 6px 10px;
      border-radius: 6px;
      background-color: #ffc107;
      color: #212529;
      font-size: 12px;
      font-weight: bold;
    }
    .footer {
      background-color: #f8f9fa;
      padding: 16px;
      text-align: center;
      font-size: 12px;
      color: #6c757d;
    }
  </style>
</head>

<body>
  <div class="container">

    <!-- HEADER -->
    <div class="header">
      <h2>✅ Demande envoyée</h2>
      <p>Merci de votre confiance</p>
    </div>

    <!-- CONTENT -->
    <div class="content">

      <p class="success">
        Bonjour <strong><%= demande.name %></strong>,
      </p>

      <p>
        Votre demande de service a bien été enregistrée.
        Voici le récapitulatif :
      </p>

      <div class="section">
        <div class="label">Service</div>
        <div class="value"><%= demande.service_name %></div>
      </div>

      <div class="section">
        <div class="label">Catégorie</div>
        <div class="value"><%= demande.category_name %></div>
      </div>

      <div class="section">
        <div class="label">Prix</div>
        <div class="value">
          <% if (demande.price) { %>
            <%= demande.price %> $
          <% } else { %>
            Sur devis
          <% } %>
        </div>
      </div>

      <div class="section">
        <div class="label">Statut</div>
        <div class="value">
          <span class="badge"><%= demande.status %></span>
        </div>
      </div>

      <div class="section">
        <div class="label">Localisation</div>
        <div class="value">
          <%= demande.location || "Détectée automatiquement" %><br>
          <small>GPS : <%= demande.coordinates %></small>
        </div>
      </div>

      <div class="section">
        <div class="label">Contact</div>
        <div class="value">
          Email : <%= demande.email %><br>
          WhatsApp : <%= demande.phone %>
        </div>
      </div>

      <p>
        📞 Notre équipe <strong>Romolayte</strong> vous contactera très bientôt
        par téléphone ou WhatsApp.
      </p>

      <p>
        Cordialement,<br>
        <strong>L’équipe Romolayte</strong>
      </p>

    </div>

    <!-- FOOTER -->
    <div class="footer">
      © <%= new Date().getFullYear() %> Romolayte — Tous droits réservés.
    </div>

  </div>
</body>
</html>