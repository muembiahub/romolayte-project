<%- include('partials/dashboard-header', { title: "Tableau de bord" }) %>

<main class="rom-dashboard-container">
  <h2 class="rom-welcome-title">
    Bienvenue <%= user.firstname %> <%= user.lastname %> 👋
  </h2>

  <p class="rom-welcome-sub">
    Rôle :
    <span class="rom-role-badge <%= user.role %>">
      <%= user.role %>
    </span>
  </p>

  <!-- ADMIN & SUPER‑ADMIN (niveau ≥ 3) -->
  <% if (user.role_level >= 3) { %>
    <div class="rom-card rom-admin-card">
      <h3>⚙️ Administration</h3>
      <p>En tant qu’administrateur, vous pouvez :</p>
      <ul>
        <li>Gérer les utilisateurs</li>
        <li>Attribuer des rôles</li>
        <li>Superviser les services et catégories</li>
      </ul>
      <a href="/dashboard/userprofiles" class="rom-btn-gradient">
        Gérer les utilisateurs
      </a>
    </div>

  <!-- PRESTATAIRE (niveau = 2) -->
  <% } else if (user.role_level === 2) { %>
    <div class="rom-card rom-prestataire-card">
      <h3>🧑‍🔧 Prestataire</h3>
      <p>
        Vous avez accès aux fonctionnalités prestataires.
      </p>
      <a href="/prestataire/missions" class="rom-btn-gradient">
        Voir mes missions
      </a>
    </div>

  <!-- USER (niveau = 1) -->
  <% } else if (user.role_level === 1) { %>
    <div class="rom-card rom-user-card">
      <h3>📂 Mon service</h3>
      <p>
        Vous êtes inscrit au service
        <strong>ID <%= user.service_id %></strong>
        dans la catégorie
        <strong>ID <%= user.category_id %></strong>.
      </p>
      <a href="/services/<%= user.service_id %>" class="rom-btn-gradient">
        Voir mon service
      </a>
    </div>

  <!-- Cas fallback (sécurité) -->
  <% } else { %>
    <div class="rom-card rom-guest-card">
      <h3>👤 Compte restreint</h3>
      <p>
        Votre rôle actuel ne vous donne pas accès aux fonctionnalités avancées.
      </p>
    </div>
  <% } %>
</main>
