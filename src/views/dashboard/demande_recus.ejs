<h2 class="rom-page-title">📋 Liste des Demandes</h2>

<% if (demandes && demandes.length > 0) { %>
  <div class="rom-cards-grid">
    <% demandes.forEach(demande => { %>
      <div class="rom-card demande-card">
        
        <!-- Header -->
        <div class="rom-card-header">
          <h3 class="rom-card-title">Demande #<%= demande.demande_id %></h3>
          <span class="rom-card-date">📅 <%= demande.created_at %></span>
        </div>

        <!-- Infos principales -->
        <ul class="rom-card-info">
          <li><strong>Nom :</strong> <%= demande.name || "Non renseigné" %></li>
          
          <!-- Email cliquable -->
          <li><strong>📧 Email :</strong>  
            <% if (demande.email) { %>
              <a href="mailto:<%= demande.email %>" class="rom-link">
                <%= demande.email %>
              </a>
            <% } else { %>
              Non renseigné
            <% } %>
          </li>

          <!-- Téléphone cliquable -->
          <li><strong>📞 Téléphone :</strong>  
            <% if (demande.phone) { %>
              <a href="tel:<%= demande.phone %>" class="rom-link">
                <%= demande.phone %>
              </a>
            <% } else { %>
              Non renseigné
            <% } %>
          </li>

          <!-- Localisation cliquable -->
          <li><strong>📍 Localisation :</strong>  
            <% if (demande.location) { %>
              <a href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(demande.location) %>" 
                 target="_blank" class="rom-link">
                <%= demande.location %>
              </a>
            <% } else { %>
              Non précisé
            <% } %>
          </li>

          <!-- Coordonnées GPS cliquables -->
          <li><strong>🌐 Coordonnées :</strong>  
            <% if (demande.coordinates) { %>
              <a href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(demande.coordinates) %>" 
                 target="_blank" class="rom-link">
                <%= demande.coordinates %>
              </a>
            <% } else { %>
              Non fournies
            <% } %>
          </li>

          <li><strong>Genre :</strong> <%= demande.gender || "Non précisé" %></li>
        </ul>

        <!-- Service demandé -->
        <div class="rom-card-service">
          <h4 class="rom-card-subtitle">🛠️ Service</h4>
          <ul>
            <li><strong>Catégorie :</strong> <%= demande.category_name || (demande.services?.category?.name) || "Non définie" %></li>
            <li><strong>Service :</strong> <%= demande.service_name || (demande.services?.name) || "Non défini" %></li>
            <li><strong>Description :</strong> <%= demande.services?.description || "Aucune description" %></li>
            <li><strong>Prix :</strong> <%= demande.price || demande.services?.price ? (demande.price || demande.services?.price) + " $" : "Non précisé" %></li>
          </ul>
        </div>

        <!-- Profil du prestataire -->
        <% if (demande.services?.user_profile) { %>
          <div class="rom-card-user">
            <h4 class="rom-card-subtitle">👤 Prestataire</h4>
            <ul>
              <li><strong>Nom :</strong> <%= demande.services.user_profile.firstname %> <%= demande.services.user_profile.lastname %></li>
              <li><strong>Email :</strong> <%= demande.services.user_profile.email %></li>
              <li><strong>WhatsApp :</strong>  
                <% if (demande.services.user_profile.whatsapp) { %>
                  <a href="https://wa.me/<%= demande.services.user_profile.whatsapp %>" target="_blank" class="rom-link">
                    <%= demande.services.user_profile.whatsapp %>
                  </a>
                <% } else { %>
                  Non fourni
                <% } %>
              </li>
              <li><strong>Rôle :</strong> <%= demande.services.user_profile.role_id %></li>
            </ul>
          </div>
        <% } %>

        <!-- Statut -->
        <!-- Statut -->
<div class="demande-card-status">
  <h4 class="rom-card-subtitle">📌 Statut</h4>
  <% if (user.role_id > 3) { %>
    <!-- Admin / Superadmin : peut modifier -->
    <select id="status-<%= demande.demande_id %>" data-id="<%= demande.demande_id %>">
      <option value="Recus" <%= demande.status === "Recus" ? "selected" : "" %>>Recus</option>
      <option value="Validé" <%= demande.status === "Validé" ? "selected" : "" %>>Validé</option>
      <option value="En cours" <%= demande.status === "En cours" ? "selected" : "" %>>En cours</option>
      <option value="Rejeté" <%= demande.status === "Rejeté" ? "selected" : "" %>>Rejeté</option>
      <option value="Supprimé" <%= demande.status === "Supprimé" ? "selected" : "" %>>Supprimé</option>
    </select>
    <small id="status-msg-<%= demande.demande_id %>" class="rom-status-msg"></small>
  <% } else { %>
    <!-- Client / Prestataire : juste voir -->
    <span class="rom-status-badge 
      <%= demande.status === 'Validé' ? 'badge-validé' : '' %>
      <%= demande.status === 'En cours' ? 'badge-encours' : '' %>
      <%= demande.status === 'Recus' ? 'badge-recus' : '' %>
      <%= demande.status === 'Rejeté' ? 'badge-rejete' : '' %>
      <%= demande.status === 'Supprimé' ? 'badge-supprime' : '' %>">
      <%= demande.status %>
    </span>
  <% } %>
</div>
      </div>
    <% }) %>
  </div>
<% } else { %>
  <p class="rom-empty">Aucune demande disponible pour votre profil.</p>
<% } %>