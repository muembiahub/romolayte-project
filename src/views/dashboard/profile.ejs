<h2 class="rom-page-title">👤 Mon Profil</h2>

<div class="rom-cards-grid">

  <!-- Carte Profil -->
  <div class="rom-card profile-card">
    <div class="profile-header">
      <img
        src="<%= user.logo ? user.logo : '/images/avatars.webp' %>"
        alt="Photo de profil"
        class="profile-avatar-large"
      />

      <div class="profile-meta">
        <h3 class="rom-card-title">
          <%= user.firstname %> <%= user.lastname %>
        </h3>

        <p class="profile-role">
          Rôle :
          <span class="rom-role-badge <%= user.role %>">
            <%= user.role %>
          </span>
        </p>
      </div>
    </div>

    <ul class="rom-card-info">
      <li>
        <strong>Email :</strong>
        <a href="mailto:<%= user.email %>" class="rom-link">
          <%= user.email %>
        </a>
      </li>
      <li><strong>Nom d’utilisateur :</strong> <%= user.username %></li>
      <li><strong>Date de naissance :</strong> <%= new Date(user.birthday).toLocaleDateString() %></li>
      <li><strong>Membre depuis :</strong> <%= new Date(user.created_at).toLocaleDateString() %></li>
    </ul>
  </div>

  <!-- Carte Actions -->
  <div class="rom-card profile-actions">
    <h3 class="rom-card-title">⚙️ Actions</h3>
    <div class="rom-cards-grid">
      <a href="/dashboard/profile/edit" class="rom-btn-gradient">✏️ Modifier mes informations</a>
      <a href="/dashboard/profile/avatar" class="rom-btn-gradient">🖼️ Modifier ma photo</a>
      <a href="/role-request" class="rom-btn-gradient">🔁 Demande de rôle</a>
    </div>
  </div>

  <!-- Section Admin -->
  <% if (user.role_level >= 3) { %>
    <div class="rom-card rom-admin-card">
      <h3 class="rom-card-title">🛡️ Administration</h3>
      <p>Vous disposez de privilèges administrateur.</p>
      <div class="rom-cards-grid">
        <a href="/dashboard/userprofiles" class="rom-btn-gradient">👥 Gérer les utilisateurs</a>
        <a href="/admin/services" class="rom-btn-gradient">🛠️ Gérer les services</a>
        <a href="/admin/categories" class="rom-btn-gradient">🗂️ Gérer les catégories</a>
      </div>
    </div>
  <% } %>

  <!-- Section Prestataire -->
  <% if (user.role_level === 2) { %>
    <div class="rom-card rom-prestataire-card">
      <h3 class="rom-card-title">🧑‍🔧 Espace Prestataire</h3>
      <p>Accédez à vos missions et disponibilités.</p>
      <div class="rom-cards-grid">
        <a href="/prestataire/missions" class="rom-btn-gradient">📋 Mes missions</a>
        <a href="/prestataire/disponibilites" class="rom-btn-gradient">📅 Mes disponibilités</a>
      </div>
    </div>
  <% } %>

  <!-- Section Utilisateur -->
  <% if (user.role_level === 1) { %>
    <div class="rom-card rom-user-card">
      <h3 class="rom-card-title">📂 Mon service</h3>
      <p>
        Vous êtes inscrit au service <strong>ID <%= user.service_id %></strong>
        dans la catégorie <strong>ID <%= user.category_id %></strong>.
      </p>
      <a href="/services/<%= user.service_id %>" class="rom-btn-gradient">
        Voir mon service
      </a>
    </div>
  <% } %>

</div>
