<h1 class="mb-4 text-center fw-bold text-primary">
  <i class="fas fa-envelope me-2"></i> Messages reçus
</h1>

<div class="card shadow-lg rounded p-4">
  <table class="table table-hover table-bordered align-middle">
    <thead class="table-dark text-center">
      <tr>
        <th>Nom</th>
        <th>Email</th>
        <th>Message</th>
        <th>Statut</th>
        <th>Date</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if (contacts && contacts.length > 0) { %>
        <% contacts.forEach(function(item) { %>
          <tr>
            <td><%= item.name %></td>
            <td>
              <a href="mailto:<%= item.email %>" class="text-info fw-semibold">
                <i class="fas fa-envelope"></i> <%= item.email %>
              </a>
            </td>
            <td><%= item.message %></td>
            <td class="text-center">
              <% if(item.status === 'non_lu'){ %>
                <span class="badge bg-danger">Non lu</span>
              <% } else if(item.status === 'en_cours'){ %>
                <span class="badge bg-warning text-dark">En cours</span>
              <% } else { %>
                <span class="badge bg-success">Répondu</span>
              <% } %>
            </td>
            <td><%= new Date(item.created_at).toLocaleString() %></td>
            <td class="text-center">
              <!-- Boutons d’action -->
              <form action="/dashboard/messages/<%= item.id %>/status" method="POST" class="d-inline">
                <input type="hidden" name="status" value="en_cours">
                <button type="submit" class="btn btn-sm btn-warning">
                  <i class="fas fa-hourglass-half"></i> En cours
                </button>
              </form>

              <form action="/dashboard/messages/<%= item.id %>/status" method="POST" class="d-inline">
                <input type="hidden" name="status" value="répondu">
                <button type="submit" class="btn btn-sm btn-success">
                  <i class="fas fa-check"></i> Répondu
                </button>
              </form>

              <form action="/dashboard/messages/<%= item.id %>/delete" method="POST" class="d-inline" 
                    onsubmit="return confirm('Supprimer ce message ?');">
                <button type="submit" class="btn btn-sm btn-danger">
                  <i class="fas fa-trash"></i> Supprimer
                </button>
              </form>
            </td>
          </tr>
        <% }); %>
      <% } else { %>
        <tr>
          <td colspan="6" class="text-center text-muted">
            Aucun message pour le moment.
          </td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>

<style>
  h1 {
    text-shadow: 1px 1px 3px rgba(0,0,0,0.2);
  }
  .table th, .table td {
    text-align: center;
    vertical-align: middle;
  }
  .btn-sm {
    margin: 2px;
  }
</style>
