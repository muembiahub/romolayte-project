<main class="container my-5">

  <!-- ================= Page Header ================= -->
  <header class="text-center mb-5">
    <h1 class="fw-bold"><%= title %></h1>
  </header>

  <% if (services && services.length > 0) { %>

    <!-- ================= Services Grid ================= -->
    <div class="row g-4">

      <% services.forEach(service => { %>

        <div class="col-sm-6 col-md-4 col-lg-3">
          <div class="card h-100 shadow-sm border-0">

            <!-- Service Image -->
            <div class="ratio ratio-4x3">
              <img
                src="<%= service.logo || 'https://ofhmwjzxakhgbafywxwp.supabase.co/storage/v1/object/public/services-images/default.webp' %>"
                alt="<%= service.name %>"
                class="card-img-top object-fit-cover"
                loading="lazy"
                onerror="this.onerror=null;this.src='https://ofhmwjzxakhgbafywxwp.supabase.co/storage/v1/object/public/services-images/default.webp';"
              >
            </div>

            <!-- Card Body -->
            <div class="card-body d-flex flex-column text-center">

              <h5 class="card-title mb-2">
                <i class="fa-solid fa-briefcase me-1 text-primary"></i>
                <%= service.name %>
              </h5>

              <% if (service.description) { %>
                <p class="card-text small text-muted mb-2">
                  <%= service.description %>
                </p>
              <% } %>

              <p class="mb-1">
                <strong>Prix :</strong>
                <%= service.price ? service.price + ' $' : 'Sur devis' %>
              </p>

              <p class="mb-3">
                <strong>Catégorie :</strong>
                <%= service.categories?.name || 'Non définie' %>
              </p>

              <!-- Action -->
              <a
                href="/services-details/<%= service.service_id %>"
                class="btn btn-outline-primary mt-auto"
              >
                Voir les détails
              </a>

            </div>

          </div>
        </div>

      <% }) %>

    </div>

  <% } else { %>

    <!-- ================= Empty State ================= -->
    <div class="alert alert-info text-center mt-5">
      <i class="fa-solid fa-circle-info me-2"></i>
      Aucun service disponible pour le moment.
    </div>

  <% } %>

</main>