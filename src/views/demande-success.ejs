<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">

      <div class="card shadow-lg border-0 rounded-4 p-5">

        <div class="text-center mb-4">
          <i class="fa-solid fa-circle-check text-success" style="font-size:4rem;"></i>
          <h2 class="mt-3">Demande envoyée avec succès 🎉</h2>
          <p class="text-muted">
            Merci <strong><%= demande.name %></strong>, voici le récapitulatif de votre demande.
          </p>
        </div>

        <hr>

        <div class="row g-3">
          <div class="col-md-6">
            <strong>Service</strong>
            <p><%= demande.service_name %></p>
          </div>

          <div class="col-md-6">
            <strong>Catégorie</strong>
            <p><%= demande.category_name %></p>
          </div>

          <div class="col-md-6">
            <strong>Prix</strong>
            <p>
              <% if (demande.price) { %>
                <%= demande.price %> $
              <% } else { %>
                Sur devis
              <% } %>
            </p>
          </div>

          <div class="col-md-6">
            <strong>Statut</strong>
            <span class="badge bg-warning text-dark">
              <%= demande.status %>
            </span>
          </div>

          <div class="col-md-6">
            <strong>Email</strong>
            <p>
              <i class="fa-solid fa-envelope text-primary me-1"></i>
              <a href="mailto:<%= demande.email %>" class="link-primary">
                <%= demande.email %>
              </a>
            </p>
          </div>

          <div class="col-md-6">
            <strong>WhatsApp</strong>
            <p>
              <i class="fa-brands fa-whatsapp text-success me-1"></i>
              <a href="https://wa.me/<%= demande.phone.replace(/\D/g, '') %>" target="_blank" class="link-success">
                <%= demande.phone %>
              </a>
            </p>
          </div>

          <div class="col-12">
            <strong>Localisation</strong>
            <p>
              <i class="fa-solid fa-location-dot text-primary me-1"></i>
              <small class="text-muted">
                Quartier / Ville : <%= demande.location %>
              </small>
            </p>
            <p>
              <i class="fa-solid fa-map-location-dot text-success me-1"></i>
              <small class="text-muted">
                Coordonnées GPS :
                <a href="https://www.google.com/maps?q=<%= demande.coordinates %>" target="_blank" class="link-primary">
                  <%= demande.coordinates %>
                </a>
              </small>
            </p>
          </div>
        </div>

        <hr class="my-4">

        <div class="d-flex justify-content-center gap-3">
          <a href="/services" class="btn btn-outline-primary">
            <i class="fa-solid fa-list me-1"></i> Autres services
          </a>
          <a href="/categories" class="btn btn-outline-secondary">
            <i class="fa-solid fa-house me-1"></i> Accueil
          </a>
        </div>

      </div>

    </div>
  </div>
</div>
