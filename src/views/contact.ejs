<!-- ================= CONTACT PAGE ================= -->

<div class="container my-5 contact-page">

  <!-- ===== PAGE HEADER ===== -->
  <header class="text-center mb-5">
    <h1 class="contact-title mb-3">
      <i class="fa-solid fa-envelope-open-text me-2 text-primary"></i>
      Contactez‑nous – ROMOLAYTE
    </h1>

    <p class="text-muted fs-6">
      Besoin d’informations, d’assistance ou d’un devis ?
      Notre équipe est à votre écoute.
    </p>

    <hr class="contact-divider">
  </header>

  <!-- ===== CONTACT INFOS ===== -->
  <section class="row g-4 text-center mb-5">

    <!-- Email -->
    <div class="col-6 col-md-3">
  <div class="contact-box">
    <i class="fa-solid fa-envelope contact-icon text-primary"></i>
    <p class="mb-0">
      <a
        href="mailto:contact@romolayte.space"
        class="contact-email"
      >
        contact@romolayte.space
      </a>
    </p>
  </div>
</div>

    <!-- Phone -->
    <div class="col-6 col-md-3">
      <div class="contact-box">
        <i class="fa-solid fa-phone contact-icon text-success"></i>
        <p class="mb-0">
          <a href="tel:+243825267122">
            +243 825 267 122
          </a>
        </p>
      </div>
    </div>

    <!-- WhatsApp -->
    <div class="col-6 col-md-3">
      <div class="contact-box">
        <i class="fa-brands fa-whatsapp contact-icon text-success"></i>
        <p class="mb-0">
          <a href="https://wa.me/243825267122" target="_blank" rel="noopener">
            WhatsApp
          </a>
        </p>
      </div>
    </div>

    <!-- Location -->
    <div class="col-6 col-md-3">
      <div class="contact-box">
        <i class="fa-solid fa-location-dot contact-icon text-danger"></i>
        <p class="mb-0">
          <a
            href="https://www.google.com/maps/place/Lubumbashi,+RDC"
            target="_blank"
            rel="noopener"
          >
            Lubumbashi, RDC
          </a>
        </p>
      </div>
    </div>

  </section>

  <!-- ===== ALERTS ===== -->
  <% if (successMessage) { %>
    <div class="alert alert-success text-center rounded-3">
      <i class="fa-solid fa-circle-check me-2"></i>
      <%= successMessage %>
    </div>
  <% } %>

  <% if (errorMessage) { %>
    <div class="alert alert-danger text-center rounded-3">
      <i class="fa-solid fa-triangle-exclamation me-2"></i>
      <%= errorMessage %>
    </div>
  <% } %>

  <!-- ===== CONTACT FORM ===== -->
  <section class="row justify-content-center">
    <div class="col-lg-8">

      <div class="card contact-card shadow-lg border-0">
        <div class="card-body p-4 p-lg-5">

          <h2 class="h5 text-center mb-4">
            Envoyez‑nous un message
          </h2>

          <form action="/send-contact" method="POST">

            <div class="mb-3">
              <label class="form-label">
                <i class="fa-solid fa-user me-2"></i> Nom
              </label>
              <input
                type="text"
                name="name"
                class="form-control"
                placeholder="Votre nom complet"
                required
              >
            </div>

            <div class="mb-3">
              <label class="form-label">
                <i class="fa-solid fa-envelope me-2"></i> Email
              </label>
              <input
                type="email"
                name="email"
                class="form-control"
                placeholder="Votre adresse email"
                required
              >
            </div>

            <div class="mb-4">
              <label class="form-label">
                <i class="fa-solid fa-comment-dots me-2"></i> Message
              </label>
              <textarea
                name="message"
                rows="5"
                class="form-control"
                placeholder="Écrivez votre message ici..."
                required
              ></textarea>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 contact-submit">
              <i class="fa-solid fa-paper-plane me-2"></i>
              Envoyer le message
            </button>

          </form>

        </div>
      </div>

    </div>
  </section>

</div>