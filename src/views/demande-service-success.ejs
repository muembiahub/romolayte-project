<%- include('partials/header') %>

<main class="contact-success">
  <h1>✅ Merci <%= name %> !</h1>
  <p>Votre demande a bien été enregistrée.</p>
  <p>Nous vous répondrons dans les plus brefs délais.</p>
  <p><strong>Service :</strong> 
    <span class="<%= isDefault.service_name ? 'default-value' : '' %>">
      <%= service_name %>
    </span>
  </p>

  <p><strong>Catégorie :</strong> 
    <span class="<%= isDefault.category_name ? 'default-value' : '' %>">
      <%= category_name %>
    </span>
  </p>

  <p><strong>Prix :</strong> 
    <span class="<%= isDefault.price ? 'default-value' : '' %>">
      <%= price %> $
    </span>
  </p>

  <p><strong>Email :</strong> 
    <span class="<%= isDefault.email ? 'default-value' : '' %>">
      <%= email %>
    </span>
  </p>

  <p><strong>Téléphone :</strong> 
    <span class="<%= isDefault.phone ? 'default-value' : '' %>">
      <%= phone %>
    </span>
  </p>

  <p><strong>Localisation :</strong> 
    <span class="<%= isDefault.location ? 'default-value' : '' %>">
      <%= location %>
    </span>
  </p>

  <p><strong>Sexe :</strong> 
    <span class="<%= isDefault.gender ? 'default-value' : '' %>">
      <%= gender %>
    </span>
  </p>

  <p><strong>Infos :</strong> 
    <span class="<%= isDefault.other_info ? 'default-value' : '' %>">
      <%= other_info %>
    </span>
  </p>

 <p>En attendant, vous pouvez consulter notre <a href="/services">liste de services</a>.</p>
</main>

<%- include('partials/footer') %>
