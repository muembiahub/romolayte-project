<main class="container my-5">

  <!-- ================= Page Header ================= -->
  <header class="text-center mb-5">
    <p class="text-muted fs-5"><%= title %></p>
  </header>

  <!-- ================= Categories Grid ================= -->
  <% if (categories && categories.length > 0) { %>

    <div class="row g-4">

      <% categories.forEach(category => { %>

        <div class="col-sm-6 col-md-4 col-lg-3">
          <div class="card h-100 shadow-sm border-0">

            <!-- Category Image -->
            <div class="ratio ratio-4x3">
              <img
                src="<%= category.logo || 'https://ofhmwjzxakhgbafywxwp.supabase.co/storage/v1/object/public/services-images/default.webp' %>"
                alt="<%= category.name %>"
                class="card-img-top object-fit-cover"
                loading="lazy"
              >
            </div>

            <!-- Card Content -->
            <div class="card-body d-flex flex-column text-center">

              <h5 class="card-title mb-2">
                <i class="fa-solid fa-tag me-1 text-primary"></i>
                <%= category.name %>
              </h5>

              <% if (category.description) { %>
                <p class="card-text text-muted small mb-3">
                  <%= category.description %>
                </p>
              <% } %>

              <a
                href="/servicecategory/<%= category.category_id %>"
                class="btn btn-outline-primary btn-sm mt-auto align-self-center"
              >
                Voir les services
              </a>

            </div>

          </div>
        </div>

      <% }) %>

    </div>

  <% } else { %>

    <!-- ================= Empty State ================= -->
    <div class="alert alert-info text-center mt-5">
      <i class="fa-solid fa-circle-info me-2"></i>
      Aucune catégorie disponible pour le moment.
    </div>

  <% } %>

</main>
