<!-- ================= AUTH PAGE ================= -->

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-xl-6 col-lg-7 col-md-9">

      <div class="card shadow-lg border-0 rounded-4 auth-panel">
        <div class="card-body p-4 p-lg-5">

          <!-- Retour -->
          <div class="mb-3">
            <a href="/categories" class="text-decoration-none">
              <i class="fa-solid fa-arrow-left me-1"></i> Retour
            </a>
          </div>

          <!-- Titre -->
          <h2 id="form-title" class="text-center fw-bold mb-4">
            Connexion
          </h2>

          <!-- ================= LOGIN FORM ================= -->
          <form  id="login-form"class="form-block active" action="/auth/login"  method="POST">
            <div class="mb-3">
              <label for="login-identifier" class="form-label">
                <i class="fa-solid fa-user me-1"></i>
                Username ou Email
              </label>
              <div class="input-group">
                <span class="input-group-text">
                  <i class="fa-solid fa-user"></i>
                </span>
                <input
                  type="text"
                  id="login-identifier"
                  name="usernameOrEmail"
                  class="form-control"
                  placeholder="Entrez votre username ou email"
                  required
                >
              </div>
              <small id="usernameError" class="text-danger"></small>
            </div>

            <div class="mb-3">
              <label for="login-password" class="form-label">
                <i class="fa-solid fa-lock me-1"></i>
                Mot de passe
              </label>
              <div class="input-group password-group">
                <span class="input-group-text">
                  <i class="fa-solid fa-lock"></i>
                </span>
                <input
                  type="password"
                  id="login-password"
                  name="password"
                  class="form-control"
                  placeholder="Entrez votre mot de passe"
                  required
                  minlength="8"
                >
                <button
                  type="button"
                  class="btn btn-outline-secondary toggle-password"
                >
                  <i class="fa-solid fa-eye"></i>
                </button>
              </div>
              <small id="passwordError" class="text-danger"></small>
            </div>

            <div class="text-end mb-3">
              <a href="/forgot-password" class="forgot-link">
                Mot de passe oublié ?
              </a>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2">
              <i class="fa-solid fa-right-to-bracket me-1"></i>
              Se connecter
            </button>
          </form>

          <!-- ================= SIGNUP FORM ================= -->
          <form
            id="signup-form"
            class="form-block"
            action="/auth/signup"
            method="POST"
          >

            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label">Prénom</label>
                <input type="text" name="firstname" class="form-control" required>
              </div>

              <div class="col-md-6">
                <label class="form-label">Nom</label>
                <input type="text" name="lastname" class="form-control" required>
              </div>

              <div class="col-12">
                <label class="form-label">Date de naissance</label>
                <input type="date" name="birthday" class="form-control" required>
              </div>

              <div class="col-12">
                <label class="form-label">Catégorie</label>
                <select id="signup-category" name="category_id" class="form-select" required>
                  <option value="" selected disabled>
                    -- Sélectionner une catégorie --
                  </option>
                  <% categories.forEach(function(cat) { %>
                    <option value="<%= cat.category_id %>">
                      <%= cat.name %>
                    </option>
                  <% }) %>
                </select>
              </div>

              <div class="col-12">
                <label class="form-label">Service</label>
                <select  id="signup-service"  name="service_id"  class="form-select"  disabled
                  required
                      >
                  <option value="">
                 -- Choisissez d’abord une catégorie --
                      </option>
                  </select>
              </div>

              <div class="col-12">
                <label class="form-label">
                  <i class="fa-solid fa-user"></i> Username
                </label>
                <input type="text" name="username" class="form-control" required>
              </div>

              <div class="col-12">
                <label class="form-label">
                  <i class="fa-brands fa-whatsapp text-success"></i>
                  Numéro WhatsApp
                </label>
                <input
                  type="tel"
                  name="whatsapp"
                  class="form-control"
                  placeholder="+243 812 345 678"
                  required
                >
              </div>

              <div class="col-12">
                <label class="form-label">
                  <i class="fa-solid fa-envelope"></i> Email
                </label>
                <input type="email" name="email" class="form-control" required>
              </div>

              <div class="col-md-6">
                <label class="form-label">Mot de passe</label>
                <input type="password" name="password" class="form-control" required minlength="8">
              </div>

              <div class="col-md-6">
                <label class="form-label">Confirmer mot de passe</label>
                <input type="password" name="confirm_password" class="form-control" required minlength="8">
              </div>
            </div>

            <button type="submit" class="btn btn-success w-100 mt-4 py-2">
              <i class="fa-solid fa-user-plus me-1"></i>
              Créer un compte
            </button>
          </form>

          <!-- ================= SOCIAL ================= -->
          <div class="social-login text-center mt-4">
            <p class="text-muted">Ou continuer avec</p>
            <div class="d-flex justify-content-center gap-3">
              <button class="btn btn-outline-primary">
                <i class="fab fa-facebook-f"></i>
              </button>
              <button class="btn btn-outline-info">
                <i class="fab fa-twitter"></i>
              </button>
              <button class="btn btn-outline-danger">
                <i class="fab fa-google"></i>
              </button>
            </div>
          </div>

          <!-- ================= TOGGLE ================= -->
          <div class="text-center mt-4">
            <span id="toggle-text">Pas encore de compte ?</span>
            <button
              type="button"
              id="toggle-btn"
              class="btn btn-link fw-bold"
            >
              Créer un compte
            </button>
          </div>

        </div>
      </div>

    </div>
  </div>
</div>