<!DOCTYPE html>
<html lang="fr" data-bs-theme="light">
<head>
  <meta charset="UTF-8">
  <title><%= title || 'Romolayte' %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  <!-- Anti-Flash Script (Doit s'exécuter avant le rendu du body) -->
  <script>
    (function () {
      const savedTheme = localStorage.getItem('theme') || 'light';
      document.documentElement.setAttribute('data-bs-theme', savedTheme);
    })();
  </script>

  <!-- Favicon -->
  <link rel="icon" href="/images/favicon.png" type="image/png">
  <!-- Bootstrap CSS (v5.3+ requis pour le support natif du mode sombre) -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Font Awesome -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
  <!-- Custom CSS -->
  <link rel="stylesheet" href="/src/public/css/style.css">
  <link rel="stylesheet" href="/src/public/css/footer.css">
  <link rel="stylesheet" href="/src/public/css/global.css">
</head>

<body class="d-flex flex-column min-vh-100">
  
  <!-- ================= HEADER ================= -->
  <header class="fixed-top shadow-sm">
    <!-- Top social + search bar -->
    <div class="bg-dark text-white py-2">
      <div class="container">
        <div class="row align-items-center g-2">
          <!-- Social icons -->
          <div class="col-md-6 text-center text-md-start">
            <ul class="list-inline mb-0">
              <li class="list-inline-item"><a href="https://www.facebook.com/Romolayte" target="_blank" class="text-white opacity-75 hover-opacity-100"><i class="fab fa-facebook-f"></i></a></li>
              <li class="list-inline-item"><a href="https://www.instagram.com/romolayte/" target="_blank" class="text-white opacity-75 hover-opacity-100"><i class="fab fa-instagram"></i></a></li>
              <li class="list-inline-item"><a href="https://twitter.com/romolayte" target="_blank" class="text-white opacity-75 hover-opacity-100"><i class="fab fa-twitter"></i></a></li>
              <li class="list-inline-item"><a href="https://www.ticktock.com/in/romolayte/" target="_blank" class="text-white opacity-75 hover-opacity-100"><i class="fab fa-tiktok"></i></a></li>
              <li class="list-inline-item"><a href="https://www.youtube.com/@romolayte" target="_blank" class="text-white opacity-75 hover-opacity-100"><i class="fab fa-youtube"></i></a></li>
              <li class="list-inline-item"><a href="https://www.linkedin.com/company/romolayte" target="_blank" class="text-white opacity-75 hover-opacity-100"><i class="fab fa-linkedin-in"></i></a></li>
            </ul>
          </div>
          <!-- Search bar -->
          <div class="col-md-6">
            <form id="searchForm" class="shadow-sm rounded">
              <div class="input-group">
                <input type="text" id="searchInput" class="form-control form-control-sm" placeholder="Rechercher un service..." name="q" required>
                <button class="btn btn-danger text-white btn-sm" type="submit">
                  <i class="fa-solid fa-search me-1"></i>
                </button>
              </div>
            </form>
            <div id="searchResults" class="mt-2 position-absolute bg-body rounded shadow" style="z-index: 1050; max-width: 500px;"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Main navbar -->
    <nav class="navbar navbar-expand-lg bg-body border-top">
      <div class="container">
        <a class="navbar-brand d-flex align-items-center" href="/categories">
          <img src="https://ofhmwjzxakhgbafywxwp.supabase.co/storage/v1/object/public/logos_category/romo_logo.jpg" alt="Romolayte" height="36" class="me-2 rounded-circle">
          <strong class="text-body">Romolayte</strong>
        </a>
        
        <div class="d-flex align-items-center gap-2 order-lg-last">
          <!-- Dropdown Theme Réintégré proprement dans le flux -->
          <div class="dropdown">
            <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
              <i id="themeIcon" class="fa-solid fa-circle-half-stroke me-1"></i> <span class="d-none d-sm-inline">Thème</span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow">
              <li>
                <a class="dropdown-item d-flex align-items-center gap-2" href="#" onclick="setTheme('light')">
                  <i class="fa-solid fa-sun text-warning"></i> Clair
                </a>
              </li>
              <li>
                <a class="dropdown-item d-flex align-items-center gap-2" href="#" onclick="setTheme('dark')">
                  <i class="fa-solid fa-moon text-primary"></i> Sombre
                </a>
              </li>
            </ul>
          </div>

          <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
            <span class="navbar-toggler-icon"></span>
          </button>
        </div>

        <div class="collapse navbar-collapse" id="mainNavbar">
          <ul class="navbar-nav ms-auto me-3">
            <li class="nav-item"><a class="nav-link" href="/categories"><i class="fa-solid fa-home me-1"></i> Accueil</a></li>
            <li class="nav-item"><a class="nav-link" href="/services">Services</a></li>
            <li class="nav-item"><a class="nav-link" href="/about">À propos</a></li>
            <li class="nav-item"><a class="nav-link" href="/contact">Contact</a></li>
            <li class="nav-item"><a class="nav-link" href="/auth"><i class="fa-solid fa-user me-1"></i> Connexion</a></li>
          </ul>
        </div>
      </div>
    </nav>
  </header>

  <!-- ================= MAIN ================= -->
  <!-- Injection de marges hautes pour compenser le header fixed-top -->
  <main class="container pt-5 mt-5 my-4 flex-grow-1">
    <%- body %>
  </main>

  <!-- ================= FOOTER ================= -->
  <footer class="footer mt-auto py-4 bg-body-tertiary border-top">
    <div class="container">
      <div class="row align-items-center g-3">
        <!-- Branding -->
        <div class="col-md-4 text-center text-md-start">
          <h5 class="fw-bold mb-1 tracking-wider text-body">ROMOLAYTE</h5>
          <p class="text-muted small mb-0">Technologie & services techniques fiables</p>
        </div>
        <!-- Liens Centrés -->
        <div class="col-md-4 text-center">
          <div class="footer-links small">
            <a href="/privacy" class="text-decoration-none text-secondary mx-2">Confidentialité</a>
            <span class="text-muted opacity-25">|</span>
            <a href="/terms" class="text-decoration-none text-secondary mx-2">Conditions</a>
          </div>
        </div>
        <!-- Copyright & Social -->
        <div class="col-md-4 text-center text-md-end">
          <div class="mb-2">
            <a href="https://www.linkedin.com/company/romolayte" target="_blank" class="text-secondary mx-2"><i class="fab fa-linkedin-in"></i></a>
            <a href="https://www.facebook.com/Romolayte" target="_blank" class="text-secondary mx-2"><i class="fab fa-facebook-f"></i></a>
            <a href="https://wa.me" target="_blank" class="text-secondary mx-2"><i class="fab fa-whatsapp"></i></a>
          </div>
          <p class="text-muted small mb-0">
            &copy; <%= new Date().getFullYear() %> <span class="fw-semibold text-body">Romolayte</span>. Tous droits réservés.
          </p>
        </div>
      </div>
    </div>
  </footer>

  <!-- ================= TOAST ================= -->
  <div class="position-fixed top-0 end-0 p-3" style="z-index: 1100">
    <div id="appToast" class="toast align-items-center border-0 shadow" role="alert" aria-live="assertive" aria-atomic="true">
      <div class="d-flex">
        <div class="toast-body" id="toastMessage">Action réussie ✅</div>
        <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
      </div>
    </div>
  </div>

  <!-- ================= SCRIPTS ================= -->
  <script src="/js/functions.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/app.js"></script>
  <script>
    function setTheme(theme) {
      document.documentElement.setAttribute('data-bs-theme', theme);
      localStorage.setItem('theme', theme);
      updateThemeIcon(theme);
    }

    function updateThemeIcon(theme) {
      const icon = document.getElementById('themeIcon');
      if (!icon) return;
      
      if (theme === 'dark') {
        icon.className = 'fa-solid fa-moon text-primary';
      } else {
        icon.className = 'fa-solid fa-sun text-warning';
      }
    }

    // Synchronisation de l'icône dès le chargement de l'arbre DOM
    document.addEventListener('DOMContentLoaded', () => {
      const activeTheme = localStorage.getItem('theme') || 'light';
      updateThemeIcon(activeTheme);
    });
  </script>
</body>
</html>
