<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/png" href="/images/favicon.png">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/header_dashboard.css">
  <script src="/js/dashboard.js"></script>
</head>
<body>
  
  <!-- Header -->
  <header class="rom-header">
    <div class="rom-header-left">
      <!-- Bouton hamburger -->
      <button class="rom-hamburger" id="rom-hamburgerBtn">
        <i class="fas fa-bars"></i>
      </button>
      <div class="logo-link">
        <a href="/">
          <img src="https://ofhmwjzxakhgbafywxwp.supabase.co/storage/v1/object/public/logos_category/romo_logo.jpg" alt="Romolayte logo">
          Romolayte
        </a>
      </div>
    </div>

    <div class="rom-header-right">
      <!-- User menu -->
      <div class="rom-user-menu" id="rom-userMenu">
        <button class="rom-user-info" id="rom-userInfoBtn">
          <img
            src="<%= user.logo ? user.logo : '/images/avatars.webp' %>"
            alt="Photo de profil"
            class="rom-profile-avatar"/>
          <span><%= user.firstname %> <%= user.lastname %></span>
          <i class="fas fa-chevron-down"></i>
        </button>
        <ul class="rom-dropdown" id="rom-userDropdown">
          <li><a href="/dashboard/profile"><i class="fas fa-id-card"></i> Mon Profil</a></li>
          <li><a href="/logout"><i class="fas fa-sign-out-alt"></i> Déconnexion</a></li>
          <li class="rom-dropdown-item rom-theme-item">
            <span>Changer Mode</span>
            <label class="rom-switch">
              <input type="checkbox" id="rom-theme-switch">
              <span class="rom-slider round"></span>
            </label>
          </li>
        </ul>
      </div>
    </div>
  </header>

  <!-- Sidebar -->
  <aside class="rom-sidebar" id="rom-sidebar">
    <div class="rom-sidebar-title">
      <a href="/dashboard" class="rom-logo-dashboard" style="text-decoration: none;">
        <i class="fas fa-chart-line"></i> <span><%= title %></span>
      </a>
    </div>
    <nav>
      <ul>
       
        <% if (user.role_level >= 1) { %>
           <li><a href="/dashboard"><i class="fas fa-home"></i> Accueil</a></li>
        <% } %>
        <% if (user.role_level >= 2) { %>
          <li><a href="/dashboard/missions"><i class="fas fa-briefcase"></i> Mes Tâches</a></li>
        <% } %>
        <% if (user.role_level >= 3) { %>
          <li class="rom-sidebar-title">Administration</li>
          <li><a href="/dashboard/userprofiles"><i class="fas fa-users"></i> Utilisateurs</a></li>
          <li><a href="/dashboard/demande_recus"><i class="fas fa-cogs"></i> Demandes</a></li>
          <li><a href="/dashboard/statistique"><i class="fas fa-chart-bar"></i> Statistique</a></li>
        <% } %>
        <% if (user.role_level >= 4) { %>
          <li class="rom-sidebar-title">Super Administration</li>
          <li><a href="/dashboard/changeroles"><i class="fas fa-user-tag"></i> Rôles & Permissions</a></li>
          <li><a href="/dashboard/changesystem"><i class="fas fa-server"></i> Paramètres Système</a></li>
        <% } %>
      </ul>
    </nav>
  </aside>


