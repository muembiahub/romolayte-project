<div class="container my-5">
  <section class="services-related">

    <!-- Section Header -->
    <div class="mb-4 text-center">
      <h2 class="mb-1">
        <i class="fa-solid fa-layer-group me-2 text-primary"></i>
        Services associés
      </h2>
      <p class="text-muted">
        Découvrez d’autres services similaires ou complémentaires
      </p>
    </div>

    <% if (services && services.length > 0) { %>

      <div class="row g-4">

        <% services.forEach(service => { %>
          <div class="col-sm-6 col-md-4 col-lg-3">

            <div class="card h-100 shadow-sm">

              <!-- Service Image -->
              <div class="ratio ratio-4x3">
                <img
                  src="<%= service.logo || '/images-services/default.webp' %>"
                  alt="<%= service.name %>"
                  class="card-img-top object-fit-cover"
                  onerror="this.onerror=null;this.src='/images-services/default.webp';"
                >
              </div>

              <!-- Card Body -->
              <div class="card-body d-flex flex-column text-center">

                <h5 class="card-title mb-2">
                  <i class="fa-solid fa-briefcase me-1 text-secondary"></i>
                  <%= service.name %>
                </h5>

                <% if (service.description) { %>
                  <p class="card-text text-muted small">
                    <%= service.description %>
                  </p>
                <% } %>

                <p class="mb-1">
                  <strong>Prix :</strong>
                  <%= service.price ? `${service.price} $` : 'Sur devis' %>
                </p>

                <p class="mb-3">
                  <strong>Catégorie :</strong>
                  <%= service.categories?.name || 'Non définie' %>
                </p>

                <!-- Action -->
                <a
                  href="/services-details/<%= service.service_id %>"
                  class="btn btn-outline-primary mt-auto"
                >
                  Voir détails
                </a>

              </div>
            </div>
          </div>
        <% }) %>

      </div>

    <% } else { %>

      <!-- Empty State -->
      <div class="alert alert-info text-center">
        <i class="fa-solid fa-circle-info me-1"></i>
        Aucun service associé disponible pour le moment.
      </div>

    <% } %>

  </section>
</div>