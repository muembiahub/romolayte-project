<main class="container my-5 d-flex justify-content-center">

  <div class="error-box text-center p-5 shadow-lg rounded-4">

    <!-- Error Code -->
    <h1 class="display-4 fw-bold text-danger">
      <%= typeof status !== 'undefined' ? status : 'Erreur' %>
    </h1>

    <!-- Main Message -->
    <p class="fs-5 mt-3">
      <%= typeof message !== 'undefined' && message ? message : "Une erreur inattendue s’est produite." %>
    </p>

    <!-- Contextual Messages -->
    <div class="mt-3 text-muted">

      <% if (status === 400) { %>
        <p>⚠️ Requête invalide. Veuillez vérifier les informations transmises.</p>

      <% } else if (status === 401) { %>
        <p>🔒 Accès restreint. Veuillez vous connecter pour continuer.</p>

      <% } else if (status === 403) { %>
        <p>🚫 Accès refusé. Vous n’avez pas les permissions nécessaires.</p>

      <% } else if (status === 404) { %>
        <p>🔍 La page ou la ressource demandée est introuvable.</p>

      <% } else if (status === 500) { %>
        <p>💥 Une erreur interne est survenue. Merci de réessayer plus tard.</p>

      <% } else { %>
        <p>❓ Une erreur inattendue s’est produite.</p>
      <% } %>

    </div>

    <!-- Actions -->
    <div class="mt-4 d-flex justify-content-center gap-3 flex-wrap">

      <a href="/categories" class="btn btn-primary px-4">
        <i class="fa-solid fa-house me-2"></i>
        Retour à l’accueil
      </a>

      <button onclick="history.back()" class="btn btn-outline-secondary px-4">
        <i class="fa-solid fa-arrow-left me-2"></i>
        Page précédente
      </button>

    </div>

  </div>

</main>
